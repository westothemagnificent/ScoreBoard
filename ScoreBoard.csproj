<Project Sdk="Godot.NET.Sdk/4.6.3">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>preview</LangVersion>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup>
        <Configurations>Debug;ExportDebug;ExportRelease;</Configurations>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' or '$(Configuration)' == 'ExportDebug' ">
        <VersionSuffix>preview-0001</VersionSuffix>
        <DebugSymbols Condition=" '$(DebugSymbols)' == '' ">true</DebugSymbols>
        <Optimize Condition=" '$(Optimize)' == '' ">false</Optimize>
        <AddonConfig>Debug</AddonConfig>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'ExportRelease' ">
        <Optimize Condition=" '$(Optimize)' == '' ">true</Optimize>
        <AddonConfig>Release</AddonConfig>
    </PropertyGroup>

</Project>